# ── Veritabanı ─────────────────────────────────────────────
DATABASE_URL="postgresql://salesos:salesos@localhost:5432/salesos?schema=public"
# Entegrasyon testleri için ayrı veritabanı (npm test)
TEST_DATABASE_URL="postgresql://salesos:salesos@localhost:5432/salesos_test?schema=public"

# ── Uygulama ───────────────────────────────────────────────
APP_URL="http://localhost:3000"
# Entegrasyon sırlarını şifrelemek için 32 byte base64 anahtar:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""
# Yeni şirkete açılışta verilecek deneme kredisi
SIGNUP_CREDITS=500

# ── AI ─────────────────────────────────────────────────────
# anthropic | openai | gemini
AI_PROVIDER="anthropic"
AI_MODEL="claude-sonnet-5"
# Hızlı/ucuz işlemler (sınıflandırma, kısa özet) için
AI_FAST_MODEL="claude-haiku-4-5-20251001"
# Birincil sağlayıcı hata verirse (boş = fallback yok)
AI_FALLBACK_PROVIDER=""
AI_FALLBACK_MODEL=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Embedding: none | openai | gemini | voyage
# none → bilgi bankası Postgres tam metin araması ile çalışır
EMBEDDING_PROVIDER="none"
EMBEDDING_MODEL=""
VOYAGE_API_KEY=""

# ── Kuyruk ─────────────────────────────────────────────────
# inline → işler web sürecinde çalışır (geliştirme). bullmq → Redis + ayrı worker (production)
QUEUE_DRIVER="inline"
REDIS_URL="redis://localhost:6379"

# ── Dosya depolama ─────────────────────────────────────────
# local → ./storage klasörü. s3 → S3 uyumlu (MinIO, R2, AWS)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="auto"
S3_BUCKET="ai-sales-os"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"

# ── Veri kaynakları (Faz 2) ────────────────────────────────
APIFY_TOKEN=""

# ── E-posta (Faz 3) ────────────────────────────────────────
# smtp | resend | brevo | sendgrid
EMAIL_PROVIDER=""
